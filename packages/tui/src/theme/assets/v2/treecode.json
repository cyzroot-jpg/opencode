        "500": "#af98e3",
        "600": "#c1acf2",
        "700": "#d3c3fc",
        "800": "#e4dbfd",
        "900": "#f6f3ff"
      },
      "accent": "$hue.orange",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    },
    "categorical": [
      "purple",
      "orange",
      "green",
      "blue",
      "red"
    ],
    "text": {
      "action": {
        "primary": {
          "$focused": "$hue.neutral.900"
        },
        "destructive": {
          "base": "$hue.neutral.900"
        }
      },
      "feedback": {
        "warning": {
          "base": "$hue.accent.200"
        }
      }
    },
    "border": {
      "base": "#b7cdc3"
    },
    "scrollbar": {
      "base": "#8ca79b"
    },
    "diff": {
      "text": {
        "added": "#1e725c",
        "context": "#7086b5",
        "hunkHeader": "#7086b5"
      },
      "background": {
        "added": "#d5e5d5",
        "removed": "#f7d8db"
      },
      "highlight": {
        "added": "#4db380",
        "removed": "#f52a65"
      },
      "lineNumber": {
        "text": "#595959",
        "background": {
          "added": "#c5d5c5",
          "removed": "#e7c8cb"
        }
      }
    },
    "syntax": {
      "number": "$hue.accent.200",
      "type": "#b0851f"
    },
    "markdown": {
      "blockQuote": "#b0851f",
      "emphasis": "#b0851f",
      "strong": "$hue.accent.200"
    },
    "accent": "$hue.orange",
    "interactive": "$hue.blue"
  },
