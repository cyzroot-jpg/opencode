        "900": "#f8fdff"
      },
      "blue": {
        "100": "#0f766e",
        "200": "#0d9488",
        "300": "#14b8a6",
        "400": "#2dd4bf",
        "500": "#5eead4",
        "600": "#99f6e4",
        "700": "#ccfbf1",
        "800": "#e6fffa",
        "900": "#f0fdfa"
      },
      "purple": {
        "100": "#6b47a7",
