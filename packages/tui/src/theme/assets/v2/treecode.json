        "900": "#17072b"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.orange",
      "neutral": "$hue.gray"
    },
    "accent": "$hue.orange",
    "interactive": "$hue.blue",
    "border": {
      "base": "#23443a"
    },
    "scrollbar": {
      "base": "#3c6b5a"
    }
  }
}
